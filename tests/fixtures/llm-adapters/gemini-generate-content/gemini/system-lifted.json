{
  "source": "documented-wire-format",
  "request": {
    "endpoint": "https://provider.example/v1beta/models/?version=1",
    "model": "fixture-model",
    "messages": [
      {
        "role": "system",
        "content": "Be brief"
      },
      {
        "role": "user",
        "content": "Hello"
      },
      {
        "role": "system",
        "content": "Be kind"
      }
