{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falcone.dev/contracts/serverless/execution-credential/v1/claims",
  "title": "Execution credential v1 claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "aud",
    "tenant",
    "workspace",
    "pool_profile",
    "revision",
    "activation",
    "attempt",
    "iat",
    "exp",
    "allowed_capabilities"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1
    },
    "aud": {
      "type": "string",
      "minLength": 1
    },
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "pool_profile": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "activation": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "string",
      "minLength": 1
    },
    "iat": {
      "type": "number",
      "minimum": 0
    },
    "exp": {
      "type": "number",
      "minimum": 0
    },
    "allowed_capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://falcone.dev/contracts/serverless/capability-grants/v1#/$defs/grant"
      }
    }
  }
}
