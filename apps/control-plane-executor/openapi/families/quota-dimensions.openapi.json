{
  "components": {
    "parameters": {
      "XApiVersion": {
        "description": "Pinned additive contract version for the v1 public API release published with gateway QoS and hardening support.",
        "in": "header",
        "name": "X-API-Version",
        "required": true,
        "schema": {
          "const": "2026-03-26",
          "pattern": "^2026-03-26$",
          "type": "string"
        }
      },
      "XCorrelationId": {
        "description": "Stable request correlation identifier reused by downstream authorization, orchestration, audit flows, and backfilled by the gateway when recovery requires it.",
        "in": "header",
        "name": "X-Correlation-Id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]{8,128}$",
          "type": "string"
        }
      }
    },
    "schemas": {
      "ConsoleQuotaDimension": {
        "properties": {
          "defaultValue": {
            "minimum": -1,
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensionKey": {
            "type": "string"
          },
          "displayLabel": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "count",
              "bytes"
            ],
            "type": "string"
          }
        },
        "required": [
          "dimensionKey",
          "displayLabel",
          "unit",
          "defaultValue",
          "description"
        ],
        "type": "object"
      },
      "ConsoleQuotaDimensionList": {
        "properties": {
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/ConsoleQuotaDimension"
            },
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "dimensions",
          "total"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": true,
        "properties": {
          "reason": {
            "type": "string"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ErrorResource": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^GW_[A-Z0-9_]+$",
            "type": "string"
          },
          "correlationId": {
            "maxLength": 128,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]{8,128}$",
            "type": "string"
          },
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/ErrorResource"
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "timestamp": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "status",
          "code",
          "message",
          "detail",
          "requestId",
          "correlationId",
          "timestamp",
          "resource"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Quota dimensions console control-plane operations. Generated from the unified public API contract for v1.",
    "summary": "Quota dimensions console control-plane operations.",
    "title": "In Falcone Quota dimensions API",
    "version": "1.22.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.0",
  "paths": {
    "/v1/quota-dimensions": {
      "get": {
        "operationId": "listQuotaDimensions",
        "parameters": [
          {
            "$ref": "#/components/parameters/XApiVersion"
          },
          {
            "$ref": "#/components/parameters/XCorrelationId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsoleQuotaDimensionList"
                }
              }
            },
            "description": "Resource returned."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "VALIDATION_ERROR: malformed or contextually inconsistent request."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "FORBIDDEN: caller lacks authority for the requested scope."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The requested entity was not found."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway QoS policy rejected the request rate for this route family."
          },
          "431": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway rejected one or more invalid or oversized request headers."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway timed out while waiting for the downstream control-plane or adapter response."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected control-plane error."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List quota dimension definitions",
        "tags": [
          "Quota-Dimensions"
        ],
        "x-actor-type-authorization": {
          "allowedActorTypes": [
            "superadmin"
          ]
        },
        "x-audiences": [
          "superadmin"
        ],
        "x-family": "quota-dimensions",
        "x-owning-service": "control_api",
        "x-rate-limit-class": "control-write",
        "x-resource-type": "quota_dimensions",
        "x-scope": "platform",
        "x-visibility": "public"
      }
    }
  },
  "servers": [
    {
      "url": "https://{publicHost}",
      "variables": {
        "publicHost": {
          "default": "api.dev.in-falcone.example.com",
          "enum": [
            "api.dev.in-falcone.example.com",
            "api.sandbox.in-falcone.example.com",
            "api.baas.musematic.ai",
            "api.in-falcone.example.com"
          ]
        }
      }
    }
  ],
  "tags": []
}
