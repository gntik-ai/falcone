{
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "description": "Optional key for safe retries of authenticated, non-streaming POST, PUT, PATCH, and DELETE requests, scoped per tenant and verified principal (API-key credential ID or subject). Final 2xx and 4xx responses are retained for 24h. Identical retries replay the original status and body with X-Idempotency-Replayed: true; original responses omit that header. A different method, normalized request target or raw body returns 422 IDEMPOTENCY_KEY_MISMATCH; an in-flight duplicate returns 409 IDEMPOTENCY_KEY_IN_PROGRESS with Retry-After. Secret-returning routes and responses over the configured size cap (default 256 KiB) block duplicate execution with 409 IDEMPOTENCY_REPLAY_UNAVAILABLE. Failed 5xx attempts can be retried. Omitted keys and GET requests retain existing behavior. A keyed mutation without a verified principal or configured replay storage returns 503 IDEMPOTENCY_UNAVAILABLE before dispatch. If recording a final response fails, the reservation blocks retries until its 24h expiry. Retry-After is a polling suggestion, not a guarantee that the reservation will be released after that delay.",
        "in": "header",
        "name": "Idempotency-Key",
        "required": false,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]{8,128}$",
          "type": "string"
        }
      },
      "PlanId": {
        "description": "Stable commercial plan identifier.",
        "in": "path",
        "name": "planId",
        "required": true,
        "schema": {
          "pattern": "^pln_[0-9a-z]+$",
          "type": "string"
        }
      },
      "XApiVersion": {
        "description": "Pinned additive contract version for the v1 public API release published with gateway QoS and hardening support.",
        "in": "header",
        "name": "X-API-Version",
        "required": true,
        "schema": {
          "const": "2026-03-26",
          "pattern": "^2026-03-26$",
          "type": "string"
        }
      },
      "XCorrelationId": {
        "description": "Stable request correlation identifier reused by downstream authorization, orchestration, audit flows, and backfilled by the gateway when recovery requires it.",
        "in": "header",
        "name": "X-Correlation-Id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._:-]{8,128}$",
          "type": "string"
        }
      }
    },
