{
  "name": "@in-falcone/web-console-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:colours": "node scripts/lint-colours.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "test:csp": "playwright test --config tests/csp/playwright.config.mjs",
    "test:dist": "node --test tests/validate-dist.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "test:i18n": "node --test tests/check-i18n.test.mjs tests/lint-i18n.test.mjs",
    "test:i18n-chunks": "node --test tests/i18n-chunks.test.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.2.5",
    "@fontsource/geist-sans": "5.2.5",
    "@gntik-ai/blocks": "0.7.0",
    "@gntik-ai/templates": "0.7.0",
    "@gntik-ai/tokens": "0.2.1",
    "@gntik-ai/ui": "0.7.0",
    "@in-falcone/console-api": "workspace:*",
    "@xyflow/react": "12.11.0",
    "i18next": "25.0.1",
    "i18next-icu": "2.3.0",
    "intl-messageformat": "10.7.16",
    "lucide-react": "0.400.0",
    "monaco-editor": "0.54.0",
    "monaco-yaml": "5.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "15.5.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.0"
  }
}
